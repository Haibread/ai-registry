---
import Default from "@astrojs/starlight/components/Banner.astro";
import { readBuildEnv } from "../lib/build-env.ts";
import { SITE_BASE } from "../lib/site.ts";

const { current } = readBuildEnv(process.env);
const notice =
	current && !current.latest
		? current.label === "next"
			? "This is the unreleased development version of the documentation."
			: `This is the documentation of an older release, ${current.label}.`
		: null;
---

{
	notice && (
		<div class="sl-banner version-banner" data-pagefind-ignore>
			{notice} <a href={SITE_BASE}>Read the latest release.</a>
		</div>
	)
}
<Default />

<style>
	.version-banner {
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-bg-accent);
		color: var(--sl-color-text-invert);
		text-align: center;
	}
	.version-banner a {
		color: var(--sl-color-text-invert);
	}
</style>
