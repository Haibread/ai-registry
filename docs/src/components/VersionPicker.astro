---
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { readBuildEnv } from "../lib/build-env.ts";
import { SITE_BASE } from "../lib/site.ts";
import { joinBase } from "../lib/versions.ts";

const { versions, current } = readBuildEnv(process.env);
const currentBase = current ? joinBase(SITE_BASE, current.path) : SITE_BASE;
---

{
	versions.length > 1 && (
		<label class="version-picker">
			<span class="sr-only">Documentation version</span>
			<select data-current-base={currentBase}>
				{versions.map((version) => (
					<option value={joinBase(SITE_BASE, version.path)} selected={version.label === current?.label}>
						{version.latest ? `${version.label} (latest)` : version.label}
					</option>
				))}
			</select>
		</label>
	)
}
<Default />

<script>
	import { switchVersion } from "../lib/switch-version.ts";

	for (const select of document.querySelectorAll<HTMLSelectElement>(".version-picker select")) {
		select.addEventListener("change", () => {
			const currentBase = select.dataset.currentBase ?? "/";
			window.location.pathname = switchVersion(window.location.pathname, currentBase, select.value);
		});
	}
</script>

<style>
	.version-picker select {
		background-color: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-1);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		padding: 0.125rem 0.5rem;
		font-size: var(--sl-text-sm);
	}
</style>
