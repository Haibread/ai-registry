{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["custom.regex"],
  "timezone": "UTC",
  "schedule": ["before 6am on Monday"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "customManagers": [
    {
      "description": "Linters installed with `go install github.com/<owner>/<repo>/…@vX.Y.Z` in workflow run steps",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["go install github\\.com/(?<depName>[^/\\s]+/[^/@\\s]+)[^@\\s]*@(?<currentValue>v[^\\s]+)"],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Binaries downloaded from GitHub releases after a `version=X.Y.Z` line: `curl … https://github.com/<owner>/<repo>/releases/download/v${version}/…`",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["version=(?<currentValue>\\d[^\\s]*)\\s+curl [^\\n]*https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/v\\$\\{version\\}/"],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Binaries downloaded from a literal GitHub release URL: `https://github.com/<owner>/<repo>/releases/download/vX.Y.Z/…`",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v\\d[^/]*)/"],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Keycloak image started with `docker run … quay.io/keycloak/keycloak:X.Y@sha256:<digest> start-dev` in the e2e job",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["(?<depName>quay\\.io/keycloak/keycloak):(?<currentValue>[\\w.-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))? start-dev"],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Service container images: `image: <name>:<tag>@sha256:<digest>` under a job's `services:`",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["\\s+image: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\\n"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for the CI linters and tools pinned in workflow run steps",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "CI tools",
      "groupSlug": "ci-tools"
    }
  ]
}
