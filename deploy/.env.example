# ============================================================================
# AI Registry — server configuration reference
# ============================================================================
# Copy this file to .env (or a location of your choice) and fill in the
# required values marked with [REQUIRED].
#
# Precedence (highest first):
#   1. Environment variable
#   2. YAML config file (set CONFIG_FILE or pass --config to the binary)
#   3. Built-in default shown in this file
#
# YAML config file key names mirror the env var names in snake_case, grouped
# by section.  See deploy/config.example.yaml for the YAML equivalent.
# ============================================================================

# ── Config file location ─────────────────────────────────────────────────────
# Path to an optional YAML config file. When set, values in the file override
# built-in defaults but are still overridden by individual env vars.
# CONFIG_FILE=

# ── Bootstrap file (optional) ─────────────────────────────────────────────────
# Path to a YAML or JSON file containing initial registry data (publishers,
# MCP servers, agents). When set, the server upserts all entries on startup
# before accepting traffic. Safe to run repeatedly — existing entries are
# skipped. Leave unset in production if you do not want any pre-loaded data.
# See deploy/bootstrap.example.yaml for the format.
#
# Resolved through the config layer (env > YAML `bootstrap_file` > default ""),
# with the `--bootstrap-file` CLI flag overriding all three.
# BOOTSTRAP_FILE=

# ── HTTP server ───────────────────────────────────────────────────────────────
# Address and port the HTTP server listens on.
HTTP_ADDR=:8081

# Timeouts for HTTP connections (Go duration strings: 30s, 2m, …).
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# Comma-separated list of allowed CORS origins for the API.
# Example: http://localhost:3000,https://registry.example.com
CORS_ALLOWED_ORIGINS=

# Public-facing base URL of this deployment. Used by the A2A global agent
# card at /.well-known/agent-card.json and by the OAuth protected-resource
# metadata document. Must be the externally reachable URL (the address
# clients use), not an internal Docker network address. Both well-known
# endpoints return HTTP 500 when this is empty rather than silently
# advertising localhost to external consumers. YAML key:
# `http.public_base_url`. Default is empty.
# Example: https://registry.example.com
PUBLIC_BASE_URL=http://localhost:3000

# CIDR of the trusted reverse proxy, used to extract the real client IP from
# X-Forwarded-For when rate-limiting.  Leave empty if there is no proxy.
# Example: 10.0.0.0/8
TRUSTED_PROXY_CIDR=

# Per-IP request budget for unauthenticated reads on /api/v1, in requests
# per minute. Defaults to 1000. Bump this for high-traffic public deployments
# or pin to a smaller value to harden against scraping.
PUBLIC_RATE_LIMIT_RPM=1000

# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string.
DATABASE_URL=postgres://user:password@host:5432/ai_registry?sslmode=disable

# Connection pool sizes.
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# ── Authentication (OIDC / Keycloak) ─────────────────────────────────────────
# [REQUIRED] OIDC issuer URL — must match the `iss` claim in issued JWTs.
# For a browser SPA this is the public-facing Keycloak URL.
# Example: http://keycloak:8080/realms/ai-registry
OIDC_ISSUER=

# [REQUIRED] Public OAuth 2.0 client ID for the browser SPA.
# Served via GET /config.json so the frontend can configure its OIDC client
# at runtime without baking this value into the Docker image.
# Example: ai-registry-web
OIDC_CLIENT_ID=

# Override the URL used to fetch the JWKS (public keys).  Set this when the
# server container cannot reach the public issuer URL directly.
# Example: http://keycloak:8080/realms/ai-registry/protocol/openid-connect/certs
OIDC_JWKS_URL=

# Expected JWT `aud` claim value. Required by the MCP authorization spec
# (OAuth 2.1 resource indicators / audience binding). When set, tokens whose
# `aud` does not contain this value are rejected — preventing tokens minted
# for unrelated clients on the same realm from being accepted here.
# Leave empty only in dev when every realm token targets this resource.
# Example: ai-registry-server
OIDC_AUDIENCE=

# SPA token storage selector exposed via /config.json. "session" (default)
# scopes OIDC tokens to the current browser tab — the XSS-safer default. Only
# set this to "local" in an e2e/CI environment where Playwright's
# storageState() must capture the authenticated session from localStorage.
# Never use "local" in production.
AUTH_STORAGE=session

# JWT payload key the validator reads group memberships from. Default
# "groups" matches Keycloak's standard group-membership mapper. Override
# when an external IdP emits group memberships under a different name
# (e.g. "realm_groups", "okta:groups") so per-workspace authorization
# and the reviewer-group check find the user's memberships.
AUTH_GROUPS_CLAIM=groups

# Group seeded on boot with a GLOBAL (all-publishers) Reviewer grant
# (ADR 0006). On startup the server ensures a group of this name exists and
# carries a Reviewer role grant with publisher_id = NULL and source = config;
# the grant is re-applied every boot, so removing it requires removing the
# seed too. Members (local group_members or a matching OIDC claim group) can
# approve / reject submissions and pending deletions on any publisher.
# Deprecated in favour of managing the group + grant via the API. Leave empty
# to skip the seed (review then requires an explicit Reviewer grant or Server
# Admin). Default: registry-reviewers.
AUTH_REVIEWER_GROUP=registry-reviewers

# ── Local accounts & registry-issued tokens (ADR 0006) ───────────────────────
# Besides OIDC, the registry can run a local email + password front door and
# sign its own access tokens. Local tokens are accepted only on the human/admin
# API and are rejected on the MCP surface (which stays OAuth-only).

# Enable the local email+password login. Default true so the registry is usable
# before any IdP is wired. Set to false to run OIDC-only (then no signing key is
# needed). Accepts true/false/1/0.
AUTH_LOCAL_LOGIN_ENABLED=true

# PEM-encoded private key (RSA or Ed25519) the registry uses to sign local
# access tokens and to publish a self-verification JWKS. REQUIRED when local
# login is enabled. This is a CREDENTIAL: supply it via an env var or secrets
# manager, never commit it to a config file or git. Generate one per
# environment (dev generates its own; prod injects via secret) — never reuse a
# key across environments. Rotating it invalidates all outstanding local
# tokens (users simply re-login). Generate one with, e.g.:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# then set AUTH_LOCAL_SIGNING_KEY to the resulting PEM block (PKCS#8 or
# PKCS#1). Supply it via a secret manager — never commit the value.
AUTH_LOCAL_SIGNING_KEY=

# Lifetime of a registry-issued local token. v1 has no refresh tokens, so local
# users re-login when it expires. Go duration string. Default: 1h.
AUTH_LOCAL_TOKEN_TTL=1h

# Bootstrap Server Admin seeded on first boot (is_server_admin = true) so the
# registry is administrable with no IdP. The seed is create-only: it never
# overwrites an existing account's password, so a rotated password survives
# reboots. Leave the email empty to skip bootstrap seeding. The email is not a
# secret and may live in the config file; the PASSWORD is a credential — env /
# secret only, never a config file or git — and must be set when the email is.
# Rotate the bootstrap password after first login.
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Service name reported in traces and metrics.
OTEL_SERVICE_NAME=ai-registry-server

# Service version reported in traces and metrics.
OTEL_SERVICE_VERSION=0.1.0

# OTLP gRPC endpoint for exporting traces (e.g. an OTel Collector).
# Leave empty to disable OTLP export and rely on the Prometheus /metrics
# endpoint only.
# Example: http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Logging ───────────────────────────────────────────────────────────────────
# Structured log level: debug | info | warn | error
LOG_LEVEL=info
